// 主页: what is already installed, plus the account entry point.
//
// The list is a snapshot Rust builds from `游戏/versions`; the page never reads
// the disk itself. Tapping a row starts the Java game host; the launcher stays
// on this page and is visible again as soon as the game host finishes.

import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { Page, HeaderButton, SheetButton } from "page.slint";

export struct InstalledRow {
    label: string,
    detail: string,
    key: string,
}

component InstalledRowView inherits Rectangle {
    in property <InstalledRow> item;
    callback uninstall(string);
    callback launch(string);
    callback actions(string);

    // Android's built-in context-menu long press is not reliable inside this
    // ListView. Detect the hold ourselves and open the same menu explicitly.
    property <bool> hold-moved: false;
    property <bool> hold-opened: false;

    height: 54px;
    background: touch.pressed ? Theme.pressed : transparent;

    Text {
        x: 0px;
        y: 7px;
        width: root.width - 16px;
        text: root.item.label;
        font-size: 15px;
        color: Theme.text;
    }

    Text {
        x: 0px;
        y: 29px;
        width: root.width - 16px;
        text: root.item.detail;
        font-size: 11px;
        color: Theme.dim;
    }

    Rectangle {
        y: root.height - Theme.hairline;
        width: 100%;
        height: Theme.hairline;
        background: Theme.line;
    }

    // Long press on Android (right click on desktop) opens this menu. The
    // ContextMenuArea expands to the whole row. The TouchArea is a visual child
    // so a short tap still reaches the launch callback.
    touch := TouchArea {
        changed pressed => {
            if (touch.pressed) {
                root.hold-moved = false;
                root.hold-opened = false;
            }
        }
        moved => {
            if (Math.abs(touch.mouse-x - touch.pressed-x) > 10px
                || Math.abs(touch.mouse-y - touch.pressed-y) > 10px) {
                root.hold-moved = true;
            }
        }
        clicked => {
            if (!root.hold-opened) {
                root.launch(root.item.key);
            }
        }
    }

    hold := Timer {
        interval: 650ms;
        running: touch.pressed && !root.hold-moved && !root.hold-opened;
        triggered => {
            root.hold-opened = true;
            root.actions(root.item.key);
        }
    }
}

export component HomePage inherits Page {
    title: "主页";

    in property <[InstalledRow]> installed;
    in property <int> installed-count: 0;
    property <string> action-key: "";

    callback accounts-requested;
    callback uninstall-version(string);
    callback launch-requested(string);
    callback repair-version(string);

    HeaderButton {
        // Right-aligned on the title's baseline: the title sits at
        // `top-inset + 16px` at 24 px, so a 30 px pill starts 1 px earlier.
        x: root.width - self.width - Theme.gutter;
        y: root.top-inset + 15px;
        label: "账户";
        clicked => {
            root.accounts-requested();
        }
    }

    VerticalLayout {
        x: Theme.gutter;
        y: root.top-inset + 64px;
        width: root.width - Theme.gutter * 2;
        height: root.height - (root.top-inset + 64px) - 8px;
        spacing: 6px;

        Text {
            height: 28px;
            text: "已安装版本 · " + root.installed-count + " 个";
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }

        if root.installed-count == 0 : Text {
            height: 60px;
            text: "还没有安装版本，去「下载」页选一个。";
            font-size: 13px;
            color: Theme.dim;
            wrap: word-wrap;
        }

        if root.installed-count > 0 : ListView {
            vertical-stretch: 1;

            for row in root.installed : InstalledRowView {
                item: row;
                uninstall(key) => {
                    root.uninstall-version(key);
                }
                launch(key) => {
                    root.launch-requested(key);
                }
                actions(key) => {
                    root.action-key = key;
                }
            }
        }
    }


    // A plain in-app sheet instead of the platform context menu: on Android
    // ContextMenuArea's long press is unreliable inside this ListView.
    if root.action-key != "" : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            clicked => {
                root.action-key = "";
            }
        }

        Rectangle {
            x: Theme.gutter;
            y: root.height - self.height - 24px;
            width: root.width - Theme.gutter * 2;
            height: 190px;
            border-radius: 14px;
            background: Theme.bar;
            border-width: 1px;
            border-color: Theme.line;

            Text {
                x: 18px;
                y: 14px;
                width: parent.width - 36px;
                text: root.action-key;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }

            VerticalLayout {
                x: 18px;
                y: 44px;
                width: parent.width - 36px;
                spacing: 8px;

                SheetButton {
                    width: 100%;
                    label: "修复游戏…";
                    clicked => {
                        root.repair-version(root.action-key);
                        root.action-key = "";
                    }
                }
                SheetButton {
                    width: 100%;
                    label: "卸载";
                    danger: true;
                    clicked => {
                        root.uninstall-version(root.action-key);
                        root.action-key = "";
                    }
                }
                SheetButton {
                    width: 100%;
                    label: "取消";
                    clicked => {
                        root.action-key = "";
                    }
                }
            }
        }
    }

}
