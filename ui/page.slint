// What every screen shares: the app background, the top safe-area inset and a
// page title. The body is deliberately empty — each screen fills it in later.

import { Theme } from "theme.slint";

/// A small pill for the page header's right edge.
///
/// Explicit x/y everywhere: Slint centres children that only declare a size,
/// and a header action has to sit exactly on the title's baseline.
export component HeaderButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 64px;
    height: 30px;
    border-radius: 15px;
    background: touch.pressed ? Theme.pressed : Theme.bar;
    border-width: 1px;
    border-color: Theme.line;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: 13px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// A two-line row: a label, a dim detail, and an optional chevron.
///
/// Used by the identity list and the "add account" chooser; both are "pick one
/// of these" lists, so they share the shape.
export component ChoiceRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> chevron: true;
    in property <bool> last: true;
    callback clicked;

    height: 62px;
    background: touch.pressed ? Theme.pressed : transparent;

    Rectangle {
        y: root.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.line;
        visible: !root.last;
    }

    Text {
        x: Theme.gutter;
        y: 11px;
        text: root.label;
        font-size: 16px;
        color: Theme.text;
    }

    Text {
        x: Theme.gutter;
        y: 33px;
        text: root.detail;
        font-size: 12px;
        color: Theme.dim;
    }

    if root.chevron : Path {
        x: root.width - 26px;
        y: (root.height - 12px) / 2;
        width: 7px;
        height: 12px;
        stroke: Theme.dim;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M1 1 L6 6 L1 11";
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// A fixed-width action button for sheets and dialogs.
export component SheetButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked;

    width: 96px;
    height: 40px;
    border-radius: 10px;
    background: root.danger
        ? (touch.pressed ? #c94751 : Theme.danger)
        : (touch.pressed ? Theme.pressed : Theme.bar);
    border-width: root.danger ? 0px : 1px;
    border-color: Theme.line;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: 14px;
        color: root.danger ? #ffffff : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// The header's back arrow, 48 px square so it is easy to hit.
export component BackButton inherits Rectangle {
    callback back;

    width: 48px;
    height: 48px;
    background: touch.pressed ? Theme.pressed : transparent;

    Path {
        x: 15px;
        y: 16px;
        width: 9px;
        height: 16px;
        stroke: Theme.text;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M8 1 L1 8 L8 15";
    }

    touch := TouchArea {
        clicked => {
            root.back();
        }
    }
}

export component Page inherits Rectangle {
    in property <string> title;
    /// `Window.safe-area-insets.top`: the notch, the status bar, or 0.
    in property <length> top-inset: 0px;

    width: 100%;
    height: 100%;
    background: Theme.bg;

    Text {
        x: Theme.gutter;
        y: root.top-inset + 16px;
        text: root.title;
        color: Theme.text;
        font-size: 24px;
        font-weight: 600;
    }
}
