// The window: one route at a time.
//
// `tabs` is the shell the bottom bar switches between; `accounts` is a pushed
// screen with its own header and back gesture. Routes own their own layout, so
// adding one means adding a branch here and nowhere else.

import { Theme } from "theme.slint";
import { BottomBar, Tab } from "navbar.slint";
import { HomePage } from "home.slint";
import { DownloadPage } from "download.slint";
import { SettingsPage } from "settings.slint";
import { AccountsPage, AccountRow } from "accounts_page.slint";
import { LoginPage, IdentityRow, LoginPhase } from "login_page.slint";

export enum Route {
    tabs,
    accounts,
    login,
}

export component AppWindow inherits Window {
    title: "Tessera";
    background: Theme.bg;
    default-font-size: 15px;

    in-out property <Tab> tab: Tab.home;
    in-out property <Route> route: Route.tabs;

    /// Device pixel ratio, set from Rust. A literal `1px` is more than one
    /// device pixel on most phones and rasterises to one or two rows
    /// depending on where it lands; `Theme.hairline` stays exactly one.
    in-out property <float> scale-factor: 1.0;
    changed scale-factor => {
        Theme.scale-factor = root.scale-factor;
    }

    /// Rows for the account screen. Rust rebuilds the whole model every time
    /// the screen opens, so the UI never reads the disk itself.
    in-out property <[AccountRow]> accounts;
    /// `Steve · Offline` for the active account, empty when none is chosen.
    in-out property <string> active-label;

    /// Identities the login screen offers: the official launcher, then every
    /// entry from `azure_app_ids.toml`.
    in-out property <[IdentityRow]> identities;
    in-out property <LoginPhase> login-phase: LoginPhase.choosing;
    in-out property <string> login-code: "";
    in-out property <string> login-url: "";
    in-out property <string> login-error: "";
    in-out property <bool> login-custom-open: false;
    in-out property <string> login-custom-id: "";
    in-out property <string> login-custom-error: "";

    // Add-account sheet. Rust clears these once the account is written.
    in-out property <bool> choosing: false;
    in-out property <bool> adding: false;
    in-out property <string> add-name: "";
    in-out property <bool> add-any: false;
    in-out property <string> add-error: "";

    /// aria2c downloader state, pushed by Rust. The download tab asks for a
    /// fresh check when it opens and swaps between the install prompt and the
    /// real list.
    in-out property <bool> aria2-installed: false;
    in-out property <bool> aria2-busy: false;
    in-out property <float> aria2-progress: 0;
    in-out property <string> aria2-message: "";

    /// JRE install state, same shape as aria2c.
    in-out property <bool> jre-installed: false;
    in-out property <bool> jre-busy: false;
    in-out property <float> jre-progress: 0;
    in-out property <string> jre-message: "";

    /// Settings: the one desktop setting the phone front-end owns today.
    in-out property <string> github-proxy: "";
    in-out property <string> settings-status: "";
    in-out property <bool> settings-status-error: false;

    callback accounts-requested;
    callback accounts-closed;
    callback account-activated(int);
    callback account-remove(int);
    callback account-add-offline(string, bool);
    /// The chooser picked the Microsoft flow: load identities, then push login.
    callback login-requested;
    callback login-start(int);
    callback login-start-custom(string);
    callback login-cancelled;
    callback login-open-url;
    callback login-copy-code;
    callback download-opened;
    callback aria2-install-requested;
    callback jre-install-requested;
    callback github-proxy-saved(string);

    // The download page never reads the disk itself: entering the tab is the
    // moment to ask whether the downloader is installed.
    changed tab => {
        if (root.tab == Tab.download) {
            root.download-opened();
        }
    }

    // ---- tabs ----

    if root.route == Route.tabs : VerticalLayout {
        // Page area. `vertical-stretch` keeps the bar pinned to the bottom no
        // matter how tall the window is.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;

            if root.tab == Tab.home : HomePage {
                top-inset: root.safe-area-insets.top;
                accounts-requested => {
                    root.accounts-requested();
                }
            }
            if root.tab == Tab.download : DownloadPage {
                top-inset: root.safe-area-insets.top;
                aria2-installed: root.aria2-installed;
                aria2-busy: root.aria2-busy;
                aria2-progress: root.aria2-progress;
                aria2-message: root.aria2-message;
                jre-installed: root.jre-installed;
                jre-busy: root.jre-busy;
                jre-progress: root.jre-progress;
                jre-message: root.jre-message;
                install-requested => {
                    root.aria2-install-requested();
                }
                jre-install-requested => {
                    root.jre-install-requested();
                }
            }
            if root.tab == Tab.settings : SettingsPage {
                top-inset: root.safe-area-insets.top;
                github-proxy <=> root.github-proxy;
                status: root.settings-status;
                status-error: root.settings-status-error;
                save-github-proxy(value) => {
                    root.github-proxy-saved(value);
                }
            }
        }

        BottomBar {
            tab: root.tab;
            safe-bottom: root.safe-area-insets.bottom;
            activated(kind) => {
                root.tab = kind;
            }
        }
    }

    // ---- accounts ----


    // ---- login ----

    if root.route == Route.login : LoginPage {
        top-inset: root.safe-area-insets.top;
        safe-bottom: root.safe-area-insets.bottom;
        identities: root.identities;
        phase: root.login-phase;
        code: root.login-code;
        url: root.login-url;
        error: root.login-error;
        keyboard-height: root.virtual-keyboard-size.height;
        custom-open <=> root.login-custom-open;
        custom-id <=> root.login-custom-id;
        custom-error <=> root.login-custom-error;
        back => {
            root.login-cancelled();
        }
        start(index) => {
            root.login-start(index);
        }
        start-custom(app-id) => {
            root.login-start-custom(app-id);
        }
        open-url => {
            root.login-open-url();
        }
        copy-code => {
            root.login-copy-code();
        }
        retry => {
            root.login-requested();
        }
    }

    if root.route == Route.accounts : AccountsPage {
        top-inset: root.safe-area-insets.top;
        safe-bottom: root.safe-area-insets.bottom;
        accounts: root.accounts;
        active-label: root.active-label;
        back => {
            root.accounts-closed();
        }
        activated(index) => {
            root.account-activated(index);
        }
        remove-confirmed(index) => {
            root.account-remove(index);
        }
        adding <=> root.adding;
        add-name <=> root.add-name;
        add-any <=> root.add-any;
        add-error <=> root.add-error;
        keyboard-height: root.virtual-keyboard-size.height;
        add-offline(name, any) => {
            root.account-add-offline(name, any);
        }
        choosing <=> root.choosing;
        login-requested => {
            root.login-requested();
        }
    }
}
