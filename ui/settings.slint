// 设置: the desktop settings page's download section, sized for a phone.
//
// Only the GitHub proxy is exposed here so far; it is the same key and the same
// `配置.toml` the desktop build reads.

import { Theme } from "theme.slint";
import { Page, SheetButton } from "page.slint";

export component SettingsPage inherits Page {
    title: "设置";

    in-out property <string> github-proxy: "";
    in property <string> status: "";
    in property <bool> status-error: false;
    callback save-github-proxy(string);

    Text {
        x: Theme.gutter;
        y: root.top-inset + 72px;
        text: "GitHub Proxy";
        font-size: 16px;
        font-weight: 600;
        color: Theme.text;
    }

    Text {
        x: Theme.gutter;
        y: root.top-inset + 98px;
        width: root.width - Theme.gutter * 2;
        height: 38px;
        text: "Java、aria2 等 GitHub 下载统一使用这个代理；留空则直连。";
        font-size: 12px;
        color: Theme.dim;
        wrap: word-wrap;
    }

    Rectangle {
        x: Theme.gutter;
        y: root.top-inset + 144px;
        width: root.width - Theme.gutter * 2;
        height: 44px;
        border-radius: 10px;
        background: Theme.bg;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.line;

        input := TextInput {
            x: 12px;
            y: 12px;
            width: root.width - Theme.gutter * 2 - 24px;
            height: 20px;
            text <=> root.github-proxy;
            font-size: 14px;
            color: Theme.text;
            single-line: true;
            accepted => {
                root.save-github-proxy(root.github-proxy);
            }
        }

        if root.github-proxy == "" : Text {
            x: 12px;
            y: 12px;
            text: "gh-proxy.com（留空直连）";
            font-size: 14px;
            color: Theme.dim;
        }
    }

    SheetButton {
        x: Theme.gutter;
        y: root.top-inset + 200px;
        width: 80px;
        label: "保存";
        clicked => {
            root.save-github-proxy(root.github-proxy);
        }
    }

    if root.status != "" : Text {
        x: Theme.gutter;
        y: root.top-inset + 252px;
        width: root.width - Theme.gutter * 2;
        height: 44px;
        text: root.status;
        font-size: 12px;
        color: root.status-error ? Theme.danger : Theme.accent;
        wrap: word-wrap;
    }
}
