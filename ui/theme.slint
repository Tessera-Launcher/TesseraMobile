// Single source of colours and metrics for the phone UI.
//
// Every colour here is a literal on purpose: when Tessera's design tokens are
// wired in, this file becomes the generated `.slint` target and nothing else
// has to change.

export global Theme {
    // Surfaces
    out property <color> bg: #0e0f13;
    out property <color> bar: #16171d;
    out property <color> pressed: #1e2028;
    out property <color> line: #262832;

    // Text
    out property <color> text: #e9eaf1;
    out property <color> dim: #7d8190;
    out property <color> accent: #4f9cf0;
    out property <color> danger: #e2565f;

    // Metrics
    out property <length> nav-height: 56px;
    out property <length> gutter: 20px;

    /// Device pixel ratio, mirrored from the window.
    in-out property <float> scale-factor: 1.0;
    /// One device pixel. Slint lengths are logical, so a literal `1px` divider
    /// is 1.33 px on a 480-wide phone and rasterises as one or two device
    /// rows depending on where it lands — two otherwise identical separators
    /// end up visibly different. Dividing by the scale keeps a hairline one
    /// device pixel thick everywhere; the extra 0.001 keeps it from rounding
    /// down to nothing.
    out property <length> hairline: 1.001px / scale-factor;
}
