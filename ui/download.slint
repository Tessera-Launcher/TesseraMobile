// 下载: dependency prompts, the version list, and the full-screen install log.
//
// Tapping a tab is not a disk read, so the window asks Rust for the dependency
// state when this tab opens. A version tap swaps the list for the install page;
// aria2's per-file notice lines are the only progress.

import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { Page, HeaderButton, SheetButton } from "page.slint";

/// One missing dependency: title, why it is needed, and its install button.
component DependencyCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> info;
    in property <string> action;
    in property <bool> busy: false;
    in property <float> progress: 0;
    in property <string> message: "";
    /// Until aria2c exists nothing else can be downloaded: dim the card and
    /// ignore the button.
    in property <bool> enabled: true;
    callback install-requested;

    width: 100%;
    height: 202px;
    border-radius: 14px;
    background: Theme.bar;
    border-width: 1px;
    border-color: Theme.line;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        x: 18px;
        y: 14px;
        text: root.title;
        font-size: 16px;
        font-weight: 600;
        color: Theme.text;
    }

    Text {
        x: 18px;
        y: 38px;
        width: root.width - 36px;
        height: 38px;
        text: root.detail;
        font-size: 12px;
        color: Theme.dim;
        wrap: word-wrap;
    }

    SheetButton {
        x: 18px;
        y: 82px;
        width: 132px;
        height: 40px;
        label: !root.enabled ? "先安装 aria2c" : (root.busy ? "下载中…" : root.action);
        clicked => {
            if (root.enabled) {
                root.install-requested();
            }
        }
    }

    Text {
        x: 18px;
        y: 130px;
        width: root.width - 36px;
        text: root.info;
        font-size: 11px;
        color: Theme.dim;
    }

    if root.busy || root.progress > 0 : Rectangle {
        x: 18px;
        y: 148px;
        width: root.width - 36px;
        height: 4px;
        border-radius: 2px;
        background: Theme.pressed;

        Rectangle {
            // Explicit x: a child that only declares a size is centred by
            // Slint, which made the bar grow from the middle.
            x: 0px;
            y: 0px;
            width: (root.width - 36px) * Math.min(1, Math.max(0, root.progress));
            height: 4px;
            border-radius: 2px;
            background: Theme.accent;
        }
    }

    if root.message != "" : Text {
        x: 18px;
        y: 160px;
        width: root.width - 36px;
        height: 36px;
        text: root.message;
        font-size: 11px;
        color: Theme.dim;
        wrap: word-wrap;
    }
}

export struct VersionRow {
    label: string,
    detail: string,
    group: bool,
    expanded: bool,
    depth: int,
    key: string,
}

component VersionRowView inherits Rectangle {
    in property <VersionRow> version;
    callback group-toggled(string);
    callback install-version(string);

    height: 54px;
    background: touch.pressed ? Theme.pressed : transparent;

    if root.version.group : Path {
        x: 12px + root.version.depth * 16px;
        y: 12px;
        width: 10px;
        height: 10px;
        fill: transparent;
        stroke: Theme.dim;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.version.expanded ? "M1 1 L6 6 L11 1" : "M1 1 L6 6 L1 11";
    }

    Text {
        x: 12px + root.version.depth * 16px + (root.version.group ? 15px : 0px);
        y: 7px;
        width: root.width - 40px;
        text: root.version.label;
        font-size: 15px;
        color: Theme.text;
    }

    Text {
        x: 12px + root.version.depth * 16px + (root.version.group ? 15px : 0px);
        y: 29px;
        width: root.width - 40px;
        text: root.version.detail;
        font-size: 11px;
        color: Theme.dim;
    }

    Rectangle {
        y: root.height - Theme.hairline;
        width: 100%;
        height: Theme.hairline;
        background: Theme.line;
    }

    touch := TouchArea {
        clicked => {
            if (root.version.group) {
                root.group-toggled(root.version.key);
            } else {
                root.install-version(root.version.label);
            }
        }
    }
}

component LoaderChoice inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> selected: false;
    callback clicked;

    height: 70px;
    border-radius: 12px;
    background: root.selected ? Theme.pressed : Theme.bar;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.line;

    Text {
        x: 14px;
        y: 12px;
        width: root.width - 52px;
        text: root.label;
        font-size: 15px;
        font-weight: 600;
        color: Theme.text;
    }

    Text {
        x: 14px;
        y: 36px;
        width: root.width - 52px;
        text: root.detail;
        font-size: 11px;
        color: Theme.dim;
        wrap: word-wrap;
    }

    Rectangle {
        x: root.width - 32px;
        y: 25px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: transparent;
        border-width: 1.5px;
        border-color: root.selected ? Theme.accent : Theme.dim;

        if root.selected : Rectangle {
            x: 4px;
            y: 4px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Theme.accent;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component DownloadPage inherits Page {
    title: "下载";

    in property <bool> aria2-installed: false;
    in property <bool> aria2-busy: false;
    in property <float> aria2-progress: 0;
    in property <string> aria2-message: "";

    in property <bool> jre-installed: false;
    in property <bool> jre-busy: false;
    in property <float> jre-progress: 0;
    in property <string> jre-message: "";

    in property <bool> runtime-installed: false;
    in property <bool> runtime-busy: false;
    in property <float> runtime-progress: 0;
    in property <string> runtime-message: "";

    in-out property <string> version-query: "";
    in property <int> version-count: 0;
    in property <[VersionRow]> versions;
    in property <bool> versions-loading: false;
    in property <string> versions-error: "";
    in property <string> install-version: "";
    in property <bool> install-configuring: false;
    in property <bool> install-busy: false;
    in property <string> install-log: "";
    in property <string> install-summary: "";
    in property <bool> install-failed: false;

    callback install-requested;
    callback jre-install-requested;
    callback runtime-install-requested;
    callback refresh-versions;
    callback versions-refilter(string);
    callback version-group-toggled(string);
    callback version-install(string);
    callback install-start(bool);
    callback install-dismissed;

    // Local choice on the configuration page; reset when a new version is
    // selected (Rust clears install-version on back as well).
    property <bool> fabric-selected: false;
    changed install-version => {
        root.fabric-selected = false;
    }

    property <bool> ready: root.aria2-installed && root.jre-installed && root.runtime-installed;

    changed version-query => {
        root.versions-refilter(root.version-query);
    }

    // Only the full dependency set unlocks the index.
    if root.ready && root.install-version == "" : VerticalLayout {
        x: Theme.gutter;
        y: root.top-inset + 64px;
        width: root.width - Theme.gutter * 2;
        height: root.height - (root.top-inset + 64px) - 8px;
        spacing: 6px;

        Rectangle {
            height: 32px;
            background: transparent;

            Text {
                x: 0px;
                y: 5px;
                text: "版本列表 · " + root.version-count + " 个";
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
            }

            HeaderButton {
                x: parent.width - self.width;
                y: 1px;
                label: "刷新";
                clicked => {
                    root.refresh-versions();
                }
            }
        }

        Rectangle {
            height: 36px;
            border-radius: 10px;
            background: Theme.bg;
            border-width: 1px;
            border-color: search.has-focus ? Theme.accent : Theme.line;

            search := TextInput {
                x: 12px;
                y: 8px;
                width: root.width - Theme.gutter * 2 - 24px;
                height: 20px;
                text <=> root.version-query;
                font-size: 13px;
                color: Theme.text;
                single-line: true;
            }

            if root.version-query == "" : Text {
                x: 12px;
                y: 8px;
                text: "搜索版本 id，例如 26.2 / 26.3";
                font-size: 13px;
                color: Theme.dim;
            }
        }

        if root.runtime-message != "" || root.jre-message != "" || root.aria2-message != "" : Text {
            width: 100%;
            height: 18px;
            text: root.runtime-message != ""
                ? root.runtime-message
                : (root.jre-message != "" ? root.jre-message : root.aria2-message);
            font-size: 11px;
            color: Theme.dim;
        }

        if root.versions-loading : Text {
            width: 100%;
            height: 40px;
            text: "正在获取版本列表…";
            font-size: 13px;
            color: Theme.dim;
            vertical-alignment: center;
        }

        if !root.versions-loading && root.versions-error != "" : Text {
            width: 100%;
            height: 72px;
            text: root.versions-error + "（点刷新重试）";
            font-size: 12px;
            color: Theme.danger;
            wrap: word-wrap;
        }

        if !root.versions-loading && root.versions-error == "" && root.versions.length == 0 : Text {
            width: 100%;
            height: 40px;
            text: "没有匹配的版本";
            font-size: 13px;
            color: Theme.dim;
            vertical-alignment: center;
        }

        if !root.versions-loading && root.versions-error == "" && root.versions.length > 0 : ListView {
            vertical-stretch: 1;

            for row in root.versions : VersionRowView {
                version: row;
                group-toggled(key) => {
                    root.version-group-toggled(key);
                }
                install-version(version) => {
                    root.version-install(version);
                }
            }
        }
    }

    // Three cards do not fit on every phone; the page pans instead of clipping
    // the third one.
    if !root.ready && root.install-version == "" : Flickable {
        x: Theme.gutter;
        y: root.top-inset + 64px;
        width: root.width - Theme.gutter * 2;
        height: root.height - (root.top-inset + 64px) - 8px;
        interactive: true;

        VerticalLayout {
            width: root.width - Theme.gutter * 2;
            spacing: 12px;

            if !root.aria2-installed : DependencyCard {
                title: "需要 aria2c";
                detail: "Tessera 用 aria2c 拉取游戏文件，和桌面版走同一条路线。";
                info: "官方 1.37.0 · arm64 · 约 2.4 MB";
                action: "下载 aria2c";
                busy: root.aria2-busy;
                progress: root.aria2-progress;
                message: root.aria2-message;
                install-requested => {
                    root.install-requested();
                }
            }

            if !root.jre-installed : DependencyCard {
                title: "需要 JRE";
                detail: "游戏本体需要 Android arm64 的 OpenJDK 28。下载后解压到应用私有目录。";
                info: "OpenJDK 28 EA · safe · 约 40 MB";
                action: "下载 JRE";
                busy: root.jre-busy;
                progress: root.jre-progress;
                message: root.jre-message;
                enabled: root.aria2-installed;
                install-requested => {
                    root.jre-install-requested();
                }
            }

            if !root.runtime-installed : DependencyCard {
                title: "需要运行库";
                detail: "Android 版 LWJGL 3.4.1、OpenAL、SDL、JNA 和 Vulkan 支持，借用 FCL 的构建。";
                info: "LWJGL 3.4.1 · Vulkan · arm64 · 约 46 MB";
                action: "下载运行库";
                busy: root.runtime-busy;
                progress: root.runtime-progress;
                message: root.runtime-message;
                enabled: root.aria2-installed;
                install-requested => {
                    root.runtime-install-requested();
                }
            }
        }
    }

    // Choosing what to install; still a full page, not a sheet.
    if root.install-version != "" && root.install-configuring : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: Theme.bg;

        VerticalLayout {
            x: Theme.gutter;
            y: root.top-inset + 18px;
            width: root.width - Theme.gutter * 2;
            height: root.height - (root.top-inset + 18px) - 8px;
            spacing: 10px;

            Rectangle {
                height: 42px;
                background: transparent;

                Text {
                    x: 0px;
                    y: 7px;
                    text: "安装 " + root.install-version;
                    font-size: 22px;
                    font-weight: 600;
                    color: Theme.text;
                }

                HeaderButton {
                    x: parent.width - self.width;
                    y: 6px;
                    label: "返回";
                    clicked => {
                        root.install-dismissed();
                    }
                }
            }

            Text {
                height: 26px;
                text: "附加内容";
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }

            LoaderChoice {
                label: "无";
                detail: "只安装 Minecraft 本体。";
                selected: !root.fabric-selected;
                clicked => {
                    root.fabric-selected = false;
                }
            }

            LoaderChoice {
                label: "Fabric Loader & API";
                detail: "安装 Fabric Loader，并自动带上 Fabric API（1.14+）。";
                selected: root.fabric-selected;
                clicked => {
                    root.fabric-selected = true;
                }
            }

            Rectangle {
                height: 10px;
                background: transparent;
            }

            SheetButton {
                width: 120px;
                label: "安装";
                clicked => {
                    root.install-start(root.fabric-selected);
                }
            }
        }
    }

    // The install screen replaces the version list; it is not a dialog.
    if root.install-version != "" && !root.install-configuring : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: Theme.bg;

        VerticalLayout {
            x: Theme.gutter;
            y: root.top-inset + 18px;
            width: root.width - Theme.gutter * 2;
            height: root.height - (root.top-inset + 18px) - 8px;
            spacing: 10px;

            Rectangle {
                height: 42px;
                background: transparent;

                Text {
                    x: 0px;
                    y: 7px;
                    text: "安装 " + root.install-version;
                    font-size: 22px;
                    font-weight: 600;
                    color: Theme.text;
                }

                if !root.install-busy : HeaderButton {
                    x: parent.width - self.width;
                    y: 6px;
                    label: "返回";
                    clicked => {
                        root.install-dismissed();
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 12px;
                background: Theme.bar;
                border-width: 1px;
                border-color: Theme.line;

                Text {
                    x: 14px;
                    y: 10px;
                    text: "活动";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.dim;
                }

                Text {
                    x: 12px;
                    y: 32px;
                    width: parent.width - 24px;
                    height: parent.height - 42px;
                    text: root.install-log;
                    font-size: 11px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                height: 44px;
                background: transparent;

                Text {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    text: root.install-summary;
                    font-size: 12px;
                    color: root.install-failed
                        ? Theme.danger
                        : (root.install-busy ? Theme.dim : Theme.accent);
                    wrap: word-wrap;
                }
            }
        }
    }
}
