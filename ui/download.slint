// 下载: the version list lands here once the two dependencies are installed.
//
// The page owns the install prompts only. Tapping a tab is not a disk read, so
// the window asks Rust for both dependencies when this tab opens; while either
// is missing, this is all the page shows.

import { Theme } from "theme.slint";
import { Page, SheetButton } from "page.slint";

/// One missing dependency: title, why it is needed, and its install button.
component DependencyCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> info;
    in property <string> action;
    in property <bool> busy: false;
    in property <float> progress: 0;
    in property <string> message: "";
    /// Until aria2c exists nothing else can be downloaded: dim the card and
    /// ignore the button.
    in property <bool> enabled: true;
    callback install-requested;

    width: 100%;
    height: 202px;
    border-radius: 14px;
    background: Theme.bar;
    border-width: 1px;
    border-color: Theme.line;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        x: 18px;
        y: 14px;
        text: root.title;
        font-size: 16px;
        font-weight: 600;
        color: Theme.text;
    }

    Text {
        x: 18px;
        y: 38px;
        width: root.width - 36px;
        height: 38px;
        text: root.detail;
        font-size: 12px;
        color: Theme.dim;
        wrap: word-wrap;
    }

    SheetButton {
        x: 18px;
        y: 82px;
        width: 132px;
        height: 40px;
        label: !root.enabled ? "先安装 aria2c" : (root.busy ? "下载中…" : root.action);
        clicked => {
            if (root.enabled) {
                root.install-requested();
            }
        }
    }

    Text {
        x: 18px;
        y: 130px;
        width: root.width - 36px;
        text: root.info;
        font-size: 11px;
        color: Theme.dim;
    }

    if root.busy || root.progress > 0 : Rectangle {
        x: 18px;
        y: 148px;
        width: root.width - 36px;
        height: 4px;
        border-radius: 2px;
        background: Theme.pressed;

        Rectangle {
            // Explicit x: a child that only declares a size is centred by
            // Slint, which made the bar grow from the middle.
            x: 0px;
            y: 0px;
            width: (root.width - 36px) * Math.min(1, Math.max(0, root.progress));
            height: 4px;
            border-radius: 2px;
            background: Theme.accent;
        }
    }

    if root.message != "" : Text {
        x: 18px;
        y: 160px;
        width: root.width - 36px;
        height: 36px;
        text: root.message;
        font-size: 11px;
        color: Theme.dim;
        wrap: word-wrap;
    }
}

export component DownloadPage inherits Page {
    title: "下载";

    in property <bool> aria2-installed: false;
    in property <bool> aria2-busy: false;
    in property <float> aria2-progress: 0;
    in property <string> aria2-message: "";

    in property <bool> jre-installed: false;
    in property <bool> jre-busy: false;
    in property <float> jre-progress: 0;
    in property <string> jre-message: "";

    in property <bool> runtime-installed: false;
    in property <bool> runtime-busy: false;
    in property <float> runtime-progress: 0;
    in property <string> runtime-message: "";

    callback install-requested;
    callback jre-install-requested;
    callback runtime-install-requested;

    // Three cards do not fit on every phone; the page pans instead of clipping
    // the third one.
    Flickable {
        x: Theme.gutter;
        y: root.top-inset + 64px;
        width: root.width - Theme.gutter * 2;
        height: root.height - (root.top-inset + 64px) - 8px;
        interactive: true;

        VerticalLayout {
            width: root.width - Theme.gutter * 2;
            spacing: 12px;

            if !root.aria2-installed : DependencyCard {
            title: "需要 aria2c";
            detail: "Tessera 用 aria2c 拉取游戏文件，和桌面版走同一条路线。";
            info: "官方 1.37.0 · arm64 · 约 2.4 MB";
            action: "下载 aria2c";
            busy: root.aria2-busy;
            progress: root.aria2-progress;
            message: root.aria2-message;
            install-requested => {
                root.install-requested();
            }
        }

        if !root.jre-installed : DependencyCard {
            title: "需要 JRE";
            detail: "游戏本体需要 Android arm64 的 OpenJDK 28。下载后解压到应用私有目录。";
            info: "OpenJDK 28 EA · safe · 约 40 MB";
            action: "下载 JRE";
            busy: root.jre-busy;
            progress: root.jre-progress;
            message: root.jre-message;
            enabled: root.aria2-installed;
            install-requested => {
                root.jre-install-requested();
            }
        }

        if !root.runtime-installed : DependencyCard {
            title: "需要运行库";
            detail: "Android 版 LWJGL 3.4.1、OpenAL、SDL、JNA 和 MobileGlues 渲染器，借用 FCL 的构建。";
            info: "LWJGL 3.4.1 · MobileGlues · arm64 · 约 46 MB";
            action: "下载运行库";
            busy: root.runtime-busy;
            progress: root.runtime-progress;
            message: root.runtime-message;
            enabled: root.aria2-installed;
            install-requested => {
                root.runtime-install-requested();
            }
        }

        if root.aria2-installed && root.jre-installed && root.runtime-installed : Text {
            width: 100%;
            height: 62px;
            // Keep the last install line (which names the route) visible;
            // after a restart both messages are empty and the generic hint
            // takes over.
            text: "aria2c、JRE 与运行库已就绪，版本列表接下来在这里出现。"
                + (root.runtime-message != ""
                    ? "\n" + root.runtime-message
                    : (root.jre-message != ""
                        ? "\n" + root.jre-message
                        : (root.aria2-message != "" ? "\n" + root.aria2-message : "")));
            font-size: 11px;
            color: Theme.dim;
            wrap: word-wrap;
        }
    }
    }
}
