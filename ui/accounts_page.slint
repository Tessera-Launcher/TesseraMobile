// The account manager, as a full-screen route rather than a tab.
//
// Layout mirrors the desktop screen — saved accounts in one list, the active one
// marked, sessions and offline identities side by side — but the interactions
// are the phone's: tap a row to switch, long-press to act on it.

import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { BackButton, ChoiceRow, HeaderButton, SheetButton } from "page.slint";

export struct AccountRow {
    index: int,
    name: string,
    application: string,
    offline: bool,
    active: bool,
}

component AccountRowView inherits Rectangle {
    in property <AccountRow> account;
    in property <bool> last;
    callback clicked;
    /// Deliberate: removing is reachable only through a hold, so a scroll that
    /// starts on a row can never delete it.
    callback long-pressed;

    // A hold past the threshold raises `long-pressed` and swallows the click
    // that would otherwise follow the release.
    property <bool> long-fired: false;

    height: 64px;
    background: touch.pressed ? Theme.pressed : transparent;

    Rectangle {
        y: root.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.line;
        visible: !root.last;
    }

    // Active marker: filled while this is the account the launcher would use.
    Rectangle {
        x: Theme.gutter;
        y: (root.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.account.active ? Theme.accent : Theme.line;
    }

    Text {
        x: Theme.gutter + 20px;
        y: 12px;
        text: root.account.name;
        font-size: 16px;
        color: root.account.active ? Theme.accent : Theme.text;
    }

    Text {
        x: Theme.gutter + 20px;
        y: 34px;
        text: root.account.application;
        font-size: 12px;
        color: Theme.dim;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.long-fired = false;
            }
        }
        clicked => {
            if !root.long-fired {
                root.clicked();
            }
        }
    }

    Timer {
        interval: 450ms;
        running: touch.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.long-pressed();
        }
    }
}

export component AccountsPage inherits Rectangle {
    in property <length> top-inset: 0px;
    in property <length> safe-bottom: 0px;
    in property <[AccountRow]> accounts;
    /// `Steve · Offline` for the active account, empty when none is chosen.
    in property <string> active-label;
    callback back();
    /// Tap a row to make it the account the launcher would use.
    callback activated(int);
    /// The confirmation sheet was accepted.
    callback remove-confirmed(int);
    /// The add sheet was accepted, with the typed name and the "any name" flag.
    callback add-offline(string, bool);

    /// The "which kind of account" chooser behind 添加.
    in-out property <bool> choosing: false;
    /// The user picked the Microsoft flow; the window pushes the login screen.
    callback login-requested;
    // Add sheet. The window owns it because Rust clears it on success.
    in-out property <bool> adding: false;
    in-out property <string> add-name: "";
    in-out property <bool> add-any: false;
    in-out property <string> add-error: "";
    /// Height of the soft keyboard, so the sheet can stay above it.
    in property <length> keyboard-height: 0px;

    // Which row a hold picked, or -1. The sheet lives entirely in the UI: only
    // the accepted answer reaches Rust.
    property <int> pending: -1;
    property <string> pending-name: "";
    property <bool> pending-offline: false;

    background: Theme.bg;

    VerticalLayout {
        // Header: back arrow and title, on one line.
        Rectangle {
            height: root.top-inset + 56px;
            background: Theme.bg;

            BackButton {
                x: 8px;
                y: root.top-inset + 4px;
                back => {
                    root.back();
                }
            }

            Text {
                x: 56px;
                y: root.top-inset + 16px;
                text: "账户";
                font-size: 20px;
                font-weight: 600;
                color: Theme.text;
            }
        }

        // The list. `ListView` keeps its own scroll position and only builds the
        // rows near the viewport.
        ListView {
            vertical-stretch: 1;

            for account in root.accounts : AccountRowView {
                account: account;
                last: account.index == root.accounts.length - 1;
                clicked => {
                    root.activated(account.index);
                }
                long-pressed => {
                    root.pending = account.index;
                    root.pending-name = account.name;
                    root.pending-offline = account.offline;
                }
            }
        }

        // Footer: where the actions live. The count is the whole story for now.
        Rectangle {
            height: 56px + root.safe-bottom;
            background: Theme.bg;

            Rectangle {
                y: 0;
                width: 100%;
                height: 1px;
                background: Theme.line;
            }

            Text {
                x: Theme.gutter;
                y: (56px - 18px) / 2;
                text: root.active-label == ""
                    ? "共 " + root.accounts.length + " 个账户"
                    : "当前：" + root.active-label;
                font-size: 12px;
                color: Theme.dim;
            }

            HeaderButton {
                x: root.width - self.width - Theme.gutter;
                y: (56px - self.height) / 2;
                label: "添加";
                clicked => {
                    root.choosing = true;
                }
            }
        }
    }

    // Empty state: sits over the list area, which is empty anyway.
    if root.accounts.length == 0 : Text {
        y: root.top-inset + 140px;
        width: 100%;
        text: "还没有账户";
        font-size: 15px;
        color: Theme.dim;
        horizontal-alignment: center;
    }

    // Chooser: official sign-in or a name that never leaves the device.
    if root.choosing : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.55);

        TouchArea {
            clicked => {
                root.choosing = false;
            }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 300px;
            height: 232px;
            border-radius: 16px;
            background: Theme.bar;
            border-width: 1px;
            border-color: Theme.line;

            TouchArea { }

            Text {
                x: 20px;
                y: 20px;
                text: "添加账户";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
            }

            ChoiceRow {
                x: 0px;
                y: 52px;
                width: 300px;
                label: "正版登录";
                detail: "用微软账户登录，可以进正版服务器";
                last: false;
                clicked => {
                    root.choosing = false;
                    root.login-requested();
                }
            }

            ChoiceRow {
                x: 0px;
                y: 114px;
                width: 300px;
                label: "离线账户";
                detail: "只存名字，不联网验证";
                clicked => {
                    root.choosing = false;
                    root.add-error = "";
                    root.adding = true;
                }
            }

            SheetButton {
                x: (300px - self.width) / 2;
                y: 184px;
                label: "取消";
                clicked => {
                    root.choosing = false;
                }
            }
        }
    }

    // Add sheet: a name and the vanilla-rules escape hatch, exactly the two
    // things the desktop login screen asks for.
    if root.adding : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.55);

        TouchArea {
            clicked => {
                root.adding = false;
            }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: max(root.top-inset + 16px, (root.height - root.keyboard-height - self.height) / 2);
            width: 300px;
            height: 236px;
            border-radius: 16px;
            background: Theme.bar;
            border-width: 1px;
            border-color: Theme.line;

            TouchArea { }

            Text {
                x: 20px;
                y: 20px;
                text: "添加离线账户";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
            }

            Rectangle {
                x: 20px;
                y: 50px;
                width: 260px;
                height: 44px;
                border-radius: 10px;
                background: Theme.bg;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.line;

                input := TextInput {
                    x: 12px;
                    y: 12px;
                    width: 236px;
                    height: 20px;
                    text <=> root.add-name;
                    font-size: 15px;
                    color: Theme.text;
                    single-line: true;
                    accepted => {
                        root.add-offline(root.add-name, root.add-any);
                    }

                    // The sheet is created when it opens, so taking focus here
                    // is the same as "focus the field the user just asked for".
                    init => {
                        self.focus();
                    }
                }

                if root.add-name == "" : Text {
                    x: 12px;
                    y: 12px;
                    text: "玩家名";
                    font-size: 15px;
                    color: Theme.dim;
                }
            }

            Rectangle {
                x: 20px;
                y: 104px;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: root.add-any ? Theme.accent : Theme.bg;
                border-width: 1px;
                border-color: root.add-any ? Theme.accent : Theme.line;

                Path {
                    x: 2px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    stroke: #ffffff;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    commands: "M2 7 L6 11 L12 3";
                    visible: root.add-any;
                }
            }

            Text {
                x: 46px;
                y: 105px;
                text: "允许任意用户名";
                font-size: 13px;
                color: Theme.text;
            }

            TouchArea {
                x: 12px;
                y: 96px;
                width: 220px;
                height: 34px;
                clicked => {
                    root.add-any = !root.add-any;
                }
            }

            if root.add-error != "" : Text {
                x: 20px;
                y: 128px;
                width: 260px;
                height: 34px;
                text: root.add-error;
                font-size: 12px;
                color: Theme.danger;
                wrap: word-wrap;
            }

            SheetButton {
                x: 76px;
                y: 168px;
                label: "取消";
                clicked => {
                    root.adding = false;
                }
            }

            SheetButton {
                x: 184px;
                y: 168px;
                label: "创建";
                danger: false;
                clicked => {
                    root.add-offline(root.add-name, root.add-any);
                }
            }
        }
    }

    // Confirmation sheet. Two deliberate acts — a hold and this button — stand in
    // for the desktop build's two presses.
    if root.pending >= 0 : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.55);

        TouchArea {
            clicked => {
                root.pending = -1;
            }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 300px;
            height: 188px;
            border-radius: 16px;
            background: Theme.bar;
            border-width: 1px;
            border-color: Theme.line;

            // Swallow taps on the card so the scrim does not close it.
            TouchArea { }

            Text {
                x: 20px;
                y: 20px;
                text: "移除账户";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
            }

            Text {
                x: 20px;
                y: 48px;
                width: 260px;
                height: 64px;
                text: "确定移除 " + root.pending-name + "？\n"
                    + (root.pending-offline
                        ? "会删除这个离线账户的文件。"
                        : "会删除这个会话的凭据文件，需要重新登录才能恢复。");
                font-size: 13px;
                color: Theme.dim;
                wrap: word-wrap;
            }

            SheetButton {
                x: 76px;
                y: 126px;
                label: "取消";
                clicked => {
                    root.pending = -1;
                }
            }

            SheetButton {
                x: 184px;
                y: 126px;
                label: "移除";
                danger: true;
                clicked => {
                    root.remove-confirmed(root.pending);
                    root.pending = -1;
                }
            }
        }
    }

}
