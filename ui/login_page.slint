// 正版登录: pick the application identity, then wait for the device code.
//
// The browser is the system's browser — the flow is device code precisely so
// nothing has to be embedded — so this page only has to show the code, hand it
// over (copy) and open the page (open-url).

import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { BackButton, ChoiceRow, SheetButton } from "page.slint";

export struct IdentityRow {
    index: int,
    label: string,
    detail: string,
}

export enum LoginPhase {
    choosing,
    waiting,
    failed,
}

export component LoginPage inherits Rectangle {
    in property <length> top-inset: 0px;
    in property <length> safe-bottom: 0px;
    in property <[IdentityRow]> identities;
    in property <LoginPhase> phase: LoginPhase.choosing;
    in property <string> code: "";
    in property <string> url: "";
    in property <string> error: "";

    callback back();
    callback start(int);
    callback open-url();
    callback copy-code();
    callback retry();

    background: Theme.bg;

    VerticalLayout {
        // Header
        Rectangle {
            height: root.top-inset + 56px;
            background: Theme.bg;

            BackButton {
                x: 8px;
                y: root.top-inset + 4px;
                back => {
                    root.back();
                }
            }

            Text {
                x: 56px;
                y: root.top-inset + 16px;
                text: "正版登录";
                font-size: 20px;
                font-weight: 600;
                color: Theme.text;
            }
        }

        // Body: one branch per phase. Named so the hint can sit at the bottom
        // of it: a child's `y` is relative to this rectangle, not the page.
        body := Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;

            // ---- choosing ----
            if root.phase == LoginPhase.choosing : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                ListView {
                    width: 100%;
                    height: 100%;

                    for row in root.identities : ChoiceRow {
                        label: row.label;
                        detail: row.detail;
                        last: row.index == root.identities.length - 1;
                        clicked => {
                            root.start(row.index);
                        }
                    }
                }

                if root.identities.length == 0 : Text {
                    width: 100%;
                    y: 40px;
                    text: "没有可用的登录身份";
                    font-size: 14px;
                    color: Theme.dim;
                    horizontal-alignment: center;
                }

                Text {
                    x: Theme.gutter;
                    y: body.height - root.safe-bottom - 56px;
                    width: root.width - Theme.gutter * 2;
                    text: "登录会跳到系统浏览器，用设备码完成，不会在应用里输入密码。";
                    font-size: 12px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }
            }

            // ---- waiting ----
            if root.phase == LoginPhase.waiting : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                Text {
                    y: 48px;
                    width: 100%;
                    text: "在浏览器打开这个地址";
                    font-size: 13px;
                    color: Theme.dim;
                    horizontal-alignment: center;
                }

                Text {
                    y: 72px;
                    width: 100%;
                    text: root.url;
                    font-size: 15px;
                    color: Theme.accent;
                    horizontal-alignment: center;
                }

                Text {
                    y: 128px;
                    width: 100%;
                    text: "输入这串代码";
                    font-size: 13px;
                    color: Theme.dim;
                    horizontal-alignment: center;
                }

                // The code is the one thing the user has to transcribe, so it is
                // the largest text in the app.
                Text {
                    y: 152px;
                    width: 100%;
                    text: root.code;
                    font-size: 30px;
                    font-weight: 600;
                    letter-spacing: 3px;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                SheetButton {
                    x: (root.width - 256px) / 2;
                    y: 224px;
                    width: 120px;
                    height: 44px;
                    label: "复制代码";
                    clicked => {
                        root.copy-code();
                    }
                }

                SheetButton {
                    x: (root.width - 256px) / 2 + 136px;
                    y: 224px;
                    width: 120px;
                    height: 44px;
                    label: "打开浏览器";
                    clicked => {
                        root.open-url();
                    }
                }

                if root.error != "" : Text {
                    x: Theme.gutter;
                    y: 320px;
                    width: root.width - Theme.gutter * 2;
                    text: root.error;
                    font-size: 12px;
                    color: Theme.danger;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                Text {
                    y: 292px;
                    width: 100%;
                    text: "完成后会自己跳到账户列表";
                    font-size: 12px;
                    color: Theme.dim;
                    horizontal-alignment: center;
                }
            }

            // ---- failed ----
            if root.phase == LoginPhase.failed : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                Text {
                    y: 64px;
                    width: 100%;
                    text: "登录失败";
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                Text {
                    x: Theme.gutter;
                    y: 100px;
                    width: root.width - Theme.gutter * 2;
                    text: root.error;
                    font-size: 13px;
                    color: Theme.danger;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                SheetButton {
                    x: (root.width - 256px) / 2;
                    y: 180px;
                    width: 120px;
                    height: 44px;
                    label: "重试";
                    clicked => {
                        root.retry();
                    }
                }

                SheetButton {
                    x: (root.width - 256px) / 2 + 136px;
                    y: 180px;
                    width: 120px;
                    height: 44px;
                    label: "返回";
                    clicked => {
                        root.back();
                    }
                }
            }
        }
    }
}
