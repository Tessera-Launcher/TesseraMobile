// 正版登录: pick the application identity, then wait for the device code.
//
// The browser is the system's browser — the flow is device code precisely so
// nothing has to be embedded — so this page only has to show the code, hand it
// over (copy) and open the page (open-url).

import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { BackButton, ChoiceRow, SheetButton } from "page.slint";

export struct IdentityRow {
    index: int,
    label: string,
    detail: string,
}

export enum LoginPhase {
    choosing,
    waiting,
    failed,
}

export component LoginPage inherits Rectangle {
    in property <length> top-inset: 0px;
    in property <length> safe-bottom: 0px;
    in property <[IdentityRow]> identities;
    in property <LoginPhase> phase: LoginPhase.choosing;
    in property <string> code: "";
    in property <string> url: "";
    in property <string> error: "";

    // Custom-app-id sheet. The window owns it because Rust validates and, on
    // success, closes it and starts the flow.
    in-out property <bool> custom-open: false;
    in-out property <string> custom-id: "";
    in-out property <string> custom-error: "";
    /// Height of the soft keyboard, so the sheet can stay above it.
    in property <length> keyboard-height: 0px;

    callback back();
    callback start(int);
    callback start-custom(string);
    callback open-url();
    callback copy-code();
    callback retry();

    background: Theme.bg;

    VerticalLayout {
        // Header
        Rectangle {
            height: root.top-inset + 56px;
            background: Theme.bg;

            BackButton {
                x: 8px;
                y: root.top-inset + 4px;
                back => {
                    root.back();
                }
            }

            Text {
                x: 56px;
                y: root.top-inset + 16px;
                text: "正版登录";
                font-size: 20px;
                font-weight: 600;
                color: Theme.text;
            }
        }

        // Body: one branch per phase. Named so the hint can sit at the bottom
        // of it: a child's `y` is relative to this rectangle, not the page.
        body := Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;

            // ---- choosing ----
            if root.phase == LoginPhase.choosing : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                // Rows sit at the top of the body; the hint stays at the
                // bottom of the page, well clear of the last divider.
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 0px;

                    for row in root.identities : ChoiceRow {
                        label: row.label;
                        detail: row.detail;
                        last: false;
                        clicked => {
                            root.start(row.index);
                        }
                    }

                    // Directly under the identities: it is a way in, not a
                    // separate section.
                    ChoiceRow {
                        label: "自定义 app id";
                        detail: "用其他启动器的客户端 id 登录";
                        last: false;
                        clicked => {
                            root.custom-error = "";
                            root.custom-open = true;
                        }
                    }
                }

                Text {
                    x: Theme.gutter;
                    y: body.height - root.safe-bottom - 56px;
                    width: root.width - Theme.gutter * 2;
                    text: "登录会跳到系统浏览器，用设备码完成，不会在应用里输入密码。";
                    font-size: 12px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }
            }

            // ---- waiting ----
            if root.phase == LoginPhase.waiting : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                Text {
                    y: 48px;
                    width: 100%;
                    text: "在浏览器打开这个地址";
                    font-size: 13px;
                    color: Theme.dim;
                    horizontal-alignment: center;
                }

                Text {
                    y: 72px;
                    width: 100%;
                    text: root.url;
                    font-size: 15px;
                    color: Theme.accent;
                    horizontal-alignment: center;
                }

                Text {
                    y: 128px;
                    width: 100%;
                    text: "输入这串代码";
                    font-size: 13px;
                    color: Theme.dim;
                    horizontal-alignment: center;
                }

                // The code is the one thing the user has to transcribe, so it is
                // the largest text in the app.
                Text {
                    y: 152px;
                    width: 100%;
                    text: root.code;
                    font-size: 30px;
                    font-weight: 600;
                    letter-spacing: 3px;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                SheetButton {
                    x: (root.width - 256px) / 2;
                    y: 224px;
                    width: 120px;
                    height: 44px;
                    label: "复制代码";
                    clicked => {
                        root.copy-code();
                    }
                }

                SheetButton {
                    x: (root.width - 256px) / 2 + 136px;
                    y: 224px;
                    width: 120px;
                    height: 44px;
                    label: "打开浏览器";
                    clicked => {
                        root.open-url();
                    }
                }

                if root.error != "" : Text {
                    x: Theme.gutter;
                    y: 320px;
                    width: root.width - Theme.gutter * 2;
                    text: root.error;
                    font-size: 12px;
                    color: Theme.danger;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                Text {
                    y: 292px;
                    width: 100%;
                    text: "完成后会自己跳到账户列表";
                    font-size: 12px;
                    color: Theme.dim;
                    horizontal-alignment: center;
                }
            }

            // ---- failed ----
            if root.phase == LoginPhase.failed : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;

                Text {
                    y: 64px;
                    width: 100%;
                    text: "登录失败";
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                Text {
                    x: Theme.gutter;
                    y: 100px;
                    width: root.width - Theme.gutter * 2;
                    text: root.error;
                    font-size: 13px;
                    color: Theme.danger;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                SheetButton {
                    x: (root.width - 256px) / 2;
                    y: 180px;
                    width: 120px;
                    height: 44px;
                    label: "重试";
                    clicked => {
                        root.retry();
                    }
                }

                SheetButton {
                    x: (root.width - 256px) / 2 + 136px;
                    y: 180px;
                    width: 120px;
                    height: 44px;
                    label: "返回";
                    clicked => {
                        root.back();
                    }
                }
            }
        }
    }

    // Custom app id sheet. The hint is the desktop build's: the id is the only
    // thing a third-party launcher has to share, and the Graph permission it
    // asks for is only used for skins.
    if root.custom-open : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.55);

        TouchArea {
            clicked => {
                root.custom-open = false;
            }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: max(root.top-inset + 16px, (root.height - root.keyboard-height - self.height) / 2);
            width: 300px;
            height: 244px;
            border-radius: 16px;
            background: Theme.bar;
            border-width: 1px;
            border-color: Theme.line;

            TouchArea { }

            Text {
                x: 20px;
                y: 20px;
                text: "自定义 app id";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
            }

            Text {
                x: 20px;
                y: 48px;
                width: 260px;
                text: "填一个 Azure 应用的 client id（Graph 权限只用于拿皮肤）。";
                font-size: 12px;
                color: Theme.dim;
                wrap: word-wrap;
            }

            Rectangle {
                x: 20px;
                y: 92px;
                width: 260px;
                height: 44px;
                border-radius: 10px;
                background: Theme.bg;
                border-width: 1px;
                border-color: custom-input.has-focus ? Theme.accent : Theme.line;

                custom-input := TextInput {
                    x: 12px;
                    y: 12px;
                    width: 236px;
                    height: 20px;
                    text <=> root.custom-id;
                    font-size: 14px;
                    color: Theme.text;
                    single-line: true;
                    accepted => {
                        root.start-custom(root.custom-id);
                    }

                    init => {
                        self.focus();
                    }
                }

                if root.custom-id == "" : Text {
                    x: 12px;
                    y: 12px;
                    text: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx";
                    font-size: 14px;
                    color: Theme.dim;
                }
            }

            if root.custom-error != "" : Text {
                x: 20px;
                y: 142px;
                width: 260px;
                height: 30px;
                text: root.custom-error;
                font-size: 12px;
                color: Theme.danger;
                wrap: word-wrap;
            }

            SheetButton {
                x: 76px;
                y: 184px;
                label: "取消";
                clicked => {
                    root.custom-open = false;
                }
            }

            SheetButton {
                x: 184px;
                y: 184px;
                label: "开始登录";
                clicked => {
                    root.start-custom(root.custom-id);
                }
            }
        }
    }
}
